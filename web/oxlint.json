{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "warn"
  },
  "plugins": ["react", "react-perf", "jsx-a11y", "typescript"],
  "rules": {
    "react/jsx-key": "error",
    "typescript/no-explicit-any": "error"
  }
}
