{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carrack.dev/recovery-manifest.v1.schema.json",
  "title": "Carrack portable recovery manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_sha256", "manifest", "locations"],
  "properties": {
    "schema_version": { "const": "carrack.recovery.v1" },
    "manifest_sha256": { "$ref": "manifest.v1.schema.json#/$defs/sha256" },
    "manifest": { "$ref": "manifest.v1.schema.json" },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/location" }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extent_sha256", "driver_id", "storage_key", "offset", "length"],
      "properties": {
        "extent_sha256": {
          "$ref": "manifest.v1.schema.json#/$defs/sha256"
        },
        "driver_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "storage_key": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "provider_version": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
