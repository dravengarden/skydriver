{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carrack.dev/manifest.v1.schema.json",
  "title": "Carrack content manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace_id",
    "object_id",
    "generation",
    "plaintext_size",
    "plaintext_sha256",
    "layout",
    "crypto",
    "packs"
  ],
  "properties": {
    "schema_version": { "const": "carrack.manifest.v1" },
    "namespace_id": { "$ref": "#/$defs/identifier" },
    "object_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "generation": { "type": "integer", "minimum": 1 },
    "plaintext_size": { "type": "integer", "minimum": 0 },
    "plaintext_sha256": { "$ref": "#/$defs/sha256" },
    "layout": { "$ref": "#/$defs/layout" },
    "crypto": { "$ref": "#/$defs/crypto" },
    "packs": {
      "type": "array",
      "items": { "$ref": "#/$defs/pack" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_block_bytes", "crypto_frame_bytes", "logical_pack_bytes"],
      "properties": {
        "physical_block_bytes": { "type": "integer", "minimum": 1 },
        "crypto_frame_bytes": { "type": "integer", "minimum": 1 },
        "logical_pack_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "crypto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "root_version", "key_epoch"],
      "properties": {
        "suite": { "const": "carrack-aes128gcm-hkdfsha256-v1" },
        "root_version": { "type": "integer", "minimum": 1 },
        "key_epoch": { "type": "integer", "minimum": 1 }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "pack_id",
        "plaintext_offset",
        "plaintext_size",
        "ciphertext_size",
        "ciphertext_sha256",
        "extents"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "pack_id": { "$ref": "#/$defs/identifier" },
        "plaintext_offset": { "type": "integer", "minimum": 0 },
        "plaintext_size": { "type": "integer", "minimum": 1 },
        "ciphertext_size": { "type": "integer", "minimum": 1 },
        "ciphertext_sha256": { "$ref": "#/$defs/sha256" },
        "extents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/extent" }
        }
      }
    },
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "first_frame",
        "frame_count",
        "ciphertext_offset",
        "ciphertext_size",
        "ciphertext_sha256"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "first_frame": { "type": "integer", "minimum": 0 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "ciphertext_offset": { "type": "integer", "minimum": 0 },
        "ciphertext_size": { "type": "integer", "minimum": 1 },
        "ciphertext_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
