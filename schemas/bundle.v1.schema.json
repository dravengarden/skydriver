{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carrack.dev/bundle.v1.schema.json",
  "title": "Carrack gapless bundle index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_bytes", "entries"],
  "properties": {
    "schema_version": { "const": "carrack.bundle.v1" },
    "data_bytes": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "offset", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
