{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skydriver-control-plane-local",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "worker-build control-plane --release"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SKYDRIVER_ENVIRONMENT": "local",
    "SKYDRIVER_OPERATOR_ACCOUNT": "operator"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SKYDRIVER_CATALOG_WATCH",
        "class_name": "CatalogWatchHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_catalog_watch",
      "new_sqlite_classes": ["CatalogWatchHub"]
    }
  ],
  "d1_databases": [
    {
      "binding": "SKYDRIVER_INDEX",
      "database_name": "skydriver-index-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKYDRIVER_MANIFESTS",
      "bucket_name": "skydriver-manifests-local"
    },
    {
      "binding": "SKYDRIVER_PAYLOAD",
      "bucket_name": "skydriver-payload-local"
    }
  ],
  "env": {
    "dev": {
      "name": "skydriver-control-plane-dev",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "routes": [
        {
          "pattern": "dev.skydriver.example",
          "custom_domain": true
        }
      ],
      "vars": {
        "SKYDRIVER_ENVIRONMENT": "dev",
        "SKYDRIVER_OPERATOR_ACCOUNT": "operator@skydriver-dev",
        "SKYDRIVER_DEFAULT_R2_MAX_PHYSICAL_BYTES": "107374182400",
        "SKYDRIVER_R2_ENDPOINT": "https://00000000000000000000000000000000.r2.cloudflarestorage.com"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SKYDRIVER_CATALOG_WATCH",
            "class_name": "CatalogWatchHub"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "SKYDRIVER_INDEX",
          "database_name": "skydriver-index-dev",
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SKYDRIVER_MANIFESTS",
          "bucket_name": "skydriver-manifests-dev"
        },
        {
          "binding": "SKYDRIVER_PAYLOAD",
          "bucket_name": "skydriver-payload-dev"
        }
      ]
    },
    "prod": {
      "name": "skydriver-control-plane-prod",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "routes": [
        {
          "pattern": "skydriver.example",
          "custom_domain": true
        }
      ],
      "vars": {
        "SKYDRIVER_ENVIRONMENT": "prod",
        "SKYDRIVER_OPERATOR_ACCOUNT": "operator@skydriver-prod",
        "SKYDRIVER_DEFAULT_R2_MAX_PHYSICAL_BYTES": "107374182400",
        "SKYDRIVER_R2_ENDPOINT": "https://00000000000000000000000000000000.r2.cloudflarestorage.com"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SKYDRIVER_CATALOG_WATCH",
            "class_name": "CatalogWatchHub"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "SKYDRIVER_INDEX",
          "database_name": "skydriver-index-prod",
          "database_id": "22222222-2222-4222-8222-222222222222",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SKYDRIVER_MANIFESTS",
          "bucket_name": "skydriver-manifests-prod"
        },
        {
          "binding": "SKYDRIVER_PAYLOAD",
          "bucket_name": "skydriver-payload-prod"
        }
      ]
    }
  }
}
