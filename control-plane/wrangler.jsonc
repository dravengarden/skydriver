{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skydriver-control-plane-local",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "worker-build control-plane --release"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SKYDRIVER_ENVIRONMENT": "local",
    "SKYDRIVER_OPERATOR_ACCOUNT": "draven"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SKYDRIVER_CATALOG_WATCH",
        "class_name": "CatalogWatchHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_catalog_watch",
      "new_sqlite_classes": ["CatalogWatchHub"]
    }
  ],
  "d1_databases": [
    {
      "binding": "SKYDRIVER_INDEX",
      "database_name": "skydriver-index-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SKYDRIVER_MANIFESTS",
      "bucket_name": "skydriver-manifests-local"
    },
    {
      "binding": "SKYDRIVER_PAYLOAD",
      "bucket_name": "skydriver-payload-local"
    }
  ],
  "env": {
    "dev": {
      "name": "skydriver-control-plane-dev",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "routes": [
        {
          "pattern": "dev.skydriver.stormbird.xyz",
          "custom_domain": true
        }
      ],
      "vars": {
        "SKYDRIVER_ENVIRONMENT": "dev",
        "SKYDRIVER_OPERATOR_ACCOUNT": "draven@skydriver-dev",
        "CARDEA_CLIENT_KEY_ID": "skydriver-dev-2026-07",
        "CARDEA_ID_TOKEN_KEY_ID": "oidc.2026-07",
        "CARDEA_ID_TOKEN_PUBLIC_KEY": "2JXxbiH5sLDeRZn0LwKyikIJDqHNpHE3JiMGj2SRtrI",
        "SKYDRIVER_DEFAULT_R2_MAX_PHYSICAL_BYTES": "107374182400",
        "SKYDRIVER_R2_ENDPOINT": "https://cf92459eee422bed7c7a8337316e8b15.r2.cloudflarestorage.com"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SKYDRIVER_CATALOG_WATCH",
            "class_name": "CatalogWatchHub"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "SKYDRIVER_INDEX",
          "database_name": "skydriver-index-dev",
          "database_id": "5367fbc7-9d8b-4a10-b7a4-a6e920fed7c2",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SKYDRIVER_MANIFESTS",
          "bucket_name": "skydriver-manifests-dev"
        },
        {
          "binding": "SKYDRIVER_PAYLOAD",
          "bucket_name": "skydriver-payload-dev"
        }
      ]
    },
    "prod": {
      "name": "skydriver-control-plane-prod",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "routes": [
        {
          "pattern": "skydriver.stormbird.xyz",
          "custom_domain": true
        }
      ],
      "vars": {
        "SKYDRIVER_ENVIRONMENT": "prod",
        "SKYDRIVER_OPERATOR_ACCOUNT": "draven@skydriver-prod",
        "SKYDRIVER_DEFAULT_R2_MAX_PHYSICAL_BYTES": "107374182400",
        "SKYDRIVER_R2_ENDPOINT": "https://cf92459eee422bed7c7a8337316e8b15.r2.cloudflarestorage.com"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SKYDRIVER_CATALOG_WATCH",
            "class_name": "CatalogWatchHub"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "SKYDRIVER_INDEX",
          "database_name": "skydriver-index-prod",
          "database_id": "2e0874de-b3a1-4c63-8592-fcbd5a2b610b",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SKYDRIVER_MANIFESTS",
          "bucket_name": "skydriver-manifests-prod"
        },
        {
          "binding": "SKYDRIVER_PAYLOAD",
          "bucket_name": "skydriver-payload-prod"
        }
      ]
    }
  }
}
