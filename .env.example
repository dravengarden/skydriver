# Skydriver routine Cloudflare deployment credentials. Copy this file to `.env`,
# set permissions to 0600, and fill in the values. The devShell exports them
# for Wrangler commands. Do not put the higher-authority token-factory token,
# Skydriver operator credential, or VFS bearer in this persistent file.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
